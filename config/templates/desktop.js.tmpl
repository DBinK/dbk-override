/**
 * @name DBinK 综合配置覆写 (桌面端)
 * @description
 *   1. 剔除所有包含香港/HK关键词的节点及策略组引用；
 *   2. 前置自定义直连与强制代理规则（自动适配代理策略组）。
 * @target Mihomo Party / Clash Verge Rev (Desktop)
 * @build {{BUILD_TAG}}
 * @see https://clashparty.org/docs/guide/override/javascript
 * @see https://github.com/mihomo-party-org/override-hub
 */

function resolveProxyGroup(config) {
  const groups = Array.isArray(config["proxy-groups"]) ? config["proxy-groups"] : [];
  if (groups.length === 0) return "PROXY";

  const candidates = ["PROXY", "节点选择", "PROXIES", "选择节点", "Auto", "自动选择"];
  for (const name of candidates) {
    if (groups.some((g) => g && g.name === name)) {
      return name;
    }
  }

  const fallback = groups.find((g) => {
    if (!g || !g.name) return false;
    const n = g.name.toUpperCase();
    return n !== "DIRECT" && n !== "REJECT" && n !== "GLOBAL";
  });

  return fallback ? fallback.name : "PROXY";
}

function main(config) {
  // 1. 过滤所有香港节点
  const hkPattern = /(港|hk|hongkong|hong kong)/i;

  if (Array.isArray(config.proxies)) {
    config.proxies = config.proxies.filter(
      (proxy) => !hkPattern.test(proxy.name)
    );
  }

  // 同步清理策略组中的香港节点，兜底 DIRECT
  if (Array.isArray(config["proxy-groups"])) {
    config["proxy-groups"].forEach((group) => {
      if (Array.isArray(group.proxies)) {
        group.proxies = group.proxies.filter(
          (name) => !hkPattern.test(name)
        );
        if (group.proxies.length === 0) {
          group.proxies.push("DIRECT");
        }
      }
    });
  }

  // 2. 注入直连与强制代理规则到顶部
  // 优先级：强制直连 (DIRECT) -> 强制代理 (PROXY 目标策略组) -> 订阅原规则
  const targetGroup = resolveProxyGroup(config);

  const rawProxyRules = [
{{PROXY_RULES}}
  ];

  const proxyRules = rawProxyRules.map((rule) => {
    const parts = rule.split(",");
    if (parts.length >= 3 && parts[2].trim() === "PROXY") {
      parts[2] = targetGroup;
      return parts.join(",");
    }
    return rule;
  });

  const directRules = [
{{DIRECT_RULES}}
  ];

  const topRules = [...directRules, ...proxyRules];

  if (!Array.isArray(config.rules)) config.rules = [];

  config.rules = config.rules.filter((rule) => !topRules.includes(rule));
  config.rules.unshift(...topRules);

  return config;
}
